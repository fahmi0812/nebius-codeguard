# Nebius CodeGuard configuration — copy to .env and fill in. Never commit .env.
# CodeGuard loads .env automatically and never prints these values.

# Nebius Token Factory API key (console → API keys)
NEBIUS_API_KEY=
# Project ID (console → project, e.g. default-project). Required for Sandboxes (Beta access must be enabled).
NEBIUS_PROJECT_ID=

# OpenAI-compatible inference endpoint (default: global). Regional endpoints can be used if a model requires it.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron model IDs on Token Factory (writer + evidence-only judge)
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_JUDGE_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Token Factory Sandboxes (Contree). contree-sdk reads NEBIUS_API_KEY + NEBIUS_PROJECT_ID and
# targets this endpoint by default; the values below are informational / for overrides.
SANDBOX_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
CONTREE_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
SANDBOX_IMAGE=python:3.12-slim

# Per-request timeout for model calls (seconds)
MODEL_TIMEOUT_SECONDS=90
